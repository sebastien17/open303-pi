[Unit]
Description=Open303 (hote MIDI USB -> DSP 303) 
# On attend que le sous-systeme son soit pret ; le reste (attente du
# controleur MIDI USB) est gere par Restart= ci-dessous + la regle udev
# fournie (99-open303-midi.rules) qui redemarre le service des qu'un
# peripherique MIDI USB est branche.
After=sound.target network.target

[Service]
Type=simple
User=open303
Group=audio
SupplementaryGroups=audio

EnvironmentFile=-/etc/default/open303
# --meter-file est place ICI et non dans EXTRA_ARGS : l'interface web
# reconstruit entierement EXTRA_ARGS a partir de son formulaire, donc tout ce
# qu'on y met a la main disparait au premier "Apply" (regression constatee :
# le vumetre de la page s'eteignait des qu'on changeait un reglage).
# EXTRA_ARGS = reglages utilisateur ; ExecStart = plomberie du service.
ExecStart=/usr/local/bin/open303_pi_host ${SAMPLE_RATE} ${BUFFER_FRAMES} \
    --meter-file /run/open303/level $EXTRA_ARGS

# Cree /run/open303 (tmpfs, donc en RAM) appartenant a l'utilisateur du
# service, et le supprime a l'arret. Sert de destination a --meter-file :
# l'interface web y lit le niveau audio sans avoir a lancer un `journalctl`
# en boucle, ce qui volerait du CPU au thread temps reel sur un Pi 3B+.
RuntimeDirectory=open303
RuntimeDirectoryMode=0755

# Redemarre automatiquement si aucun port MIDI n'est trouve au lancement
# (ex: Digitakt pas encore branche) ou en cas de crash/xrun fatal.
Restart=on-failure
RestartSec=3

# Priorite temps reel : necessaire pour que RTAUDIO_SCHEDULE_REALTIME
# fonctionne sans lancer le service en root.
LimitRTPRIO=95
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
